o Cube

v -0.5 -0.5 -0.5   # 1: bottom-left-front 
v  0.5 -0.5 -0.5   # 2: bottom-right-front
v  0.5  0.5 -0.5   # 3: top-right-front   
v -0.5  0.5 -0.5   # 4: top-left-front    
v -0.5 -0.5  0.5   # 5: bottom-left-back  
v  0.5 -0.5  0.5   # 6: bottom-right-back 
v  0.5  0.5  0.5   # 7: top-right-back    
v -0.5  0.5  0.5   # 8: top-left-back     

vt 0.0 0.0         # 1: bottom-left 
vt 1.0 0.0         # 2: bottom-right
vt 1.0 1.0         # 3: top-right   
vt 0.0 1.0         # 4: top-left    

vn  0.0  0.0 -1.0  # 1: Front  (-Z)
vn  0.0  0.0  1.0  # 2: Back   (+Z)
vn  0.0 -1.0  0.0  # 3: Bottom (-Y)
vn  0.0  1.0  0.0  # 4: Top    (+Y)
vn -1.0  0.0  0.0  # 5: Left   (-X)
vn  1.0  0.0  0.0  # 6: Right  (+X)

f 4/3/1 3/4/1 2/1/1 1/2/1    # Front  (-Z)
f 6/2/2 7/3/2 8/4/2 5/1/2    # Back   (+Z)
f 2/2/3 6/3/3 5/4/3 1/1/3    # Bottom (-Y)
f 3/3/6 7/4/6 6/1/6 2/2/6    # Right  (+X)
f 4/4/4 8/1/4 7/2/4 3/3/4    # Top    (+Y)
f 8/3/5 4/4/5 1/1/5 5/2/5    # Left   (-X)
